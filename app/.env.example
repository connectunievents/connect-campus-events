# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. NEVER expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the app (used for OAuth + Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Payments ----
# demo   = simulated payment, no money moves (good for the capstone demo)
# stripe = real Stripe Checkout (use test keys first)
PAYMENT_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (optional): notify owners about sponsor inquiries ----
RESEND_API_KEY=
EMAIL_FROM="Connect <onboarding@resend.dev>"
OWNER_NOTIFY_EMAIL=

# Show "Continue with Microsoft" once the Azure provider is set up in Supabase
NEXT_PUBLIC_AUTH_MICROSOFT=0
# Offer "Use email instead" (magic link) on the login page
NEXT_PUBLIC_AUTH_EMAIL=0
